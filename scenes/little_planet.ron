// The stereographic ("little planet") projection at work: camera hovering
// just above a ring of crystals and spheres, with a field of view (200
// degrees) wide enough that the ground curls into a horizon-ring around a
// central crystal. Looking straight down means the default up-vector is
// degenerate (parallel to the view direction), hence the explicit `vup`.
// Render with: cargo run --release -- scenes/little_planet.ron
(
    camera: (
        look_from: (0.0, 1.2, -1.0),
        look_at: (0.0, -1.0, -1.0),
        vup: (0.0, 0.0, -1.0),
        kind: Stereographic,
        vfov: 200.0,
    ),
    ambient: (0.12, 0.12, 0.12),
    sky_bottom: (0.85, 0.15, 0.55),
    sky_top: (1.0, 0.85, 0.1),
    lights: [
        Point(position: (0.0, 5.0, -1.0), color: (1.0, 1.0, 0.95), intensity: 55.0),
        Point(position: (-3.0, 1.5, -3.0), color: (0.6, 0.75, 1.0), intensity: 12.0),
        Point(position: (3.0, 1.0, 1.0), color: (1.0, 0.7, 0.5), intensity: 10.0),
    ],
    objects: [
        Sphere(center: (0.0, -100.5, -1.0), radius: 100.0, material: Lambertian(albedo: Checker(a: (0.5, 0.5, 0.55), b: (0.32, 0.3, 0.34), scale: 2.5))),
        // Center of the "planet": a crystal directly under the camera.
        Mesh(path: "assets/crystal_dense.obj", material: Dielectric(ior: 1.8), scale: 0.6, translate: (0.0, 0.1, -1.0)),
        // A ring of six objects around it, arranged hexagonally.
        Sphere(center: (1.3, -0.15, -1.0), radius: 0.35, material: Metal(albedo: Solid((0.92, 0.92, 0.95)), fuzz: 0.0)),
        Sphere(center: (0.65, -0.2, 0.126), radius: 0.3, material: Lambertian(albedo: Checker(a: (0.9, 0.15, 0.5), b: (0.1, 0.8, 0.85), scale: 6.0))),
        Mesh(path: "assets/crystal_dense.obj", material: Dielectric(ior: 1.7), scale: 0.45, translate: (-0.65, 0.0, 0.126)),
        Sphere(center: (-1.3, -0.2, -1.0), radius: 0.3, material: Metal(albedo: Solid((0.9, 0.75, 0.35)), fuzz: 0.08)),
        Mesh(path: "assets/crystal_dense.obj", material: Dielectric(ior: 1.75), scale: 0.4, translate: (-0.65, 0.0, -2.126)),
        Sphere(center: (0.65, -0.15, -2.126), radius: 0.35, material: Lambertian(albedo: Noise(color: (1.0, 0.5, 0.1), scale: 5.0, octaves: 4))),
    ],
)
