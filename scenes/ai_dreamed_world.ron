// A closed SD -> lumin asset loop: every texture here was generated by
// Stable Diffusion (see assets/textures/ai/, made via the sdcli tool) and
// then rendered by lumin's own physically-based path. The nebula is used as
// an equirectangular environment map, so it both forms the backdrop AND is
// the light source reflected in the mirror and refracted through the glass.
// Render with: cargo run --release -- scenes/ai_dreamed_world.ron -s 256
(
    camera: (
        look_from: (0.0, 0.6, 3.4),
        look_at: (0.0, 0.0, -1.0),
        vfov: 42.0,
    ),
    ambient: (0.12, 0.12, 0.16),
    environment: Some(Image("assets/textures/ai/nebula_env.png")),
    lights: [
        Point(position: (-4.0, 3.0, 3.0), color: (1.0, 0.95, 0.9), intensity: 22.0),
        Point(position: (3.0, 1.5, 2.0), color: (0.6, 0.7, 1.0), intensity: 12.0),
    ],
    objects: [
        // AI-textured gas giant, front and center.
        Sphere(center: (0.0, -0.1, -1.0), radius: 0.9,
               material: Lambertian(albedo: Image("assets/textures/ai/planet_tex.png"))),
        // Polished mirror moon reflecting the nebula.
        Sphere(center: (-1.5, 0.1, -0.7), radius: 0.5,
               material: Metal(albedo: Solid((0.95, 0.95, 0.97)), fuzz: 0.0)),
        // Glass moon refracting the environment behind it.
        Sphere(center: (1.4, -0.15, -0.4), radius: 0.45,
               material: Dielectric(ior: 1.5)),
        // Small brushed-metal companion to catch extra highlights.
        Sphere(center: (0.5, -0.35, 0.2), radius: 0.22,
               material: Metal(albedo: Solid((0.9, 0.75, 0.5)), fuzz: 0.12)),
    ],
)
