// The Stanford bunny (69,451 triangles) - stress test for the OBJ loader
// and BVH. Source: alecjacobson/common-3d-test-models.
// Render with: cargo run --release -- scenes/bunny.ron -s 128
(
    camera: (
        look_from: (0.0, 0.6, 2.2),
        look_at: (0.1, 0.35, -1.0),
        vfov: 40.0,
    ),
    sky_bottom: (1.0, 1.0, 1.0),
    sky_top: (0.5, 0.7, 1.0),
    lights: [
        Point(position: (-3.0, 4.0, 2.5), color: (1.0, 1.0, 1.0), intensity: 35.0),
        Point(position: (3.0, 2.5, 2.0), color: (0.7, 0.8, 1.0), intensity: 14.0),
    ],
    objects: [
        Sphere(center: (0.0, -100.5, -1.0), radius: 100.0, material: Lambertian(albedo: (0.6, 0.6, 0.65))),
        Mesh(path: "assets/external/bunny.obj", material: Lambertian(albedo: (0.85, 0.8, 0.7)), scale: 8.0, translate: (0.14, -0.764, -1.19)),
    ],
)
