// Camera embedded in the throat of the twisted, fluted spiral horn
// (examples/gen_spiral_horn.rs), about a quarter of the way up from the
// closed tip. Same reasoning as geode_interior.ron: the horn's wall is
// Lambertian (checkered, brightly lit) so there's something for the nearby
// Dielectric crystal and Metal sphere to actually reflect/refract - an
// all-Metal interior would just be black.
// Render: cargo run --release -- scenes/spiral_horn_interior.ron -o renders/out.png
// Or with a glitch mode: --glitch hit-chain-drift / angular-fold / axis-swap-reflect
(
    camera: (
        look_from: (-0.29, 1.0, -1.6),
        look_at: (0.15, 1.35, -2.0),
        vfov: 55.0,
    ),
    ambient: (0.09, 0.09, 0.09),
    sky_bottom: (1.0, 0.85, 0.1),
    sky_top: (0.85, 0.15, 0.55),
    lights: [
        Point(position: (1.0, -0.3, -1.2), color: (1.0, 0.85, 0.6), intensity: 8.0),
        Point(position: (1.61, 4.24, -3.15), color: (0.5, 0.7, 1.0), intensity: 16.0),
        Point(position: (-0.6, 1.47, -1.91), color: (1.0, 0.95, 0.85), intensity: 3.0),
    ],
    objects: [
        Mesh(path: "assets/spiral_horn.obj", material: Lambertian(albedo: Checker(a: (0.45, 0.08, 0.18), b: (0.7, 0.6, 0.22), scale: 4.0)), scale: 2.2, translate: (0.3, -1.3, -2.2)),
        Sphere(center: (0.28, 0.92, -1.98), radius: 0.1, material: Metal(albedo: Solid((0.9, 0.9, 0.95)), fuzz: 0.0)),
        Mesh(path: "assets/crystal.obj", material: Dielectric(ior: 1.6), scale: 0.1, translate: (-0.16, 1.16, -1.76)),
    ],
)
