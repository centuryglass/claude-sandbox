// A 360-degree panorama camera dropped into the middle of a ring of
// crystals and mirror spheres - objects both ahead of and behind look_at
// show up in the same frame, wrapped left/right across the seam. Meant to
// be viewed as a full equirectangular image (a 2:1 aspect ratio matches the
// projection's actual geometry - crop/stretch otherwise).
// Render with: cargo run --release -- scenes/equirect_crystal.ron --aspect 2.0
// Or with a glitch: cargo run --release -- scenes/equirect_crystal.ron --aspect 2.0 --glitch hit-chain-drift
(
    camera: (
        look_from: (0.0, 0.1, -0.3),
        look_at: (0.0, 0.05, -1.3),
        kind: Equirectangular,
    ),
    ambient: (0.1, 0.1, 0.1),
    sky_bottom: (1.0, 0.85, 0.1),
    sky_top: (0.85, 0.15, 0.55),
    lights: [
        Point(position: (-3.0, 4.0, -1.0), color: (1.0, 1.0, 1.0), intensity: 40.0),
        Point(position: (2.5, 2.5, 2.0), color: (1.0, 0.85, 0.6), intensity: 20.0),
        Point(position: (0.0, 1.5, 1.5), color: (0.6, 0.75, 1.0), intensity: 12.0),
    ],
    objects: [
        Sphere(center: (0.0, -100.5, -1.0), radius: 100.0, material: Lambertian(albedo: Checker(a: (0.55, 0.5, 0.55), b: (0.35, 0.32, 0.36), scale: 3.0))),
        // Ahead: the big crystal, front and center of the panorama.
        Mesh(path: "assets/crystal_dense.obj", material: Dielectric(ior: 1.8), scale: 1.0, translate: (0.0, 0.2, -1.4)),
        // Off to the right: a close mirror sphere.
        Sphere(center: (1.0, -0.15, -0.35), radius: 0.4, material: Metal(albedo: Solid((0.92, 0.92, 0.95)), fuzz: 0.0)),
        // Off to the left: a small accent crystal.
        Mesh(path: "assets/crystal_dense.obj", material: Dielectric(ior: 1.7), scale: 0.45, translate: (-0.9, -0.35, -0.5)),
        // Behind the camera (+z): another crystal and a warm metal sphere,
        // so the seam of the panorama has something worth wrapping around.
        Mesh(path: "assets/crystal_dense.obj", material: Dielectric(ior: 1.75), scale: 0.55, translate: (-0.6, -0.3, 0.9)),
        Sphere(center: (0.7, -0.25, 1.1), radius: 0.3, material: Metal(albedo: Solid((0.9, 0.75, 0.35)), fuzz: 0.08)),
    ],
)
