// Three spheres showing off diffuse, mirror, and glass materials.
// Render with: cargo run --release -- scenes/reflection_demo.ron
(
    camera: (
        look_from: (0.0, 0.8, 2.5),
        look_at: (0.0, 0.0, -1.0),
        vfov: 45.0,
    ),
    sky_bottom: (1.0, 1.0, 1.0),
    sky_top: (0.5, 0.7, 1.0),
    lights: [
        Point(position: (-4.0, 5.0, 2.0), color: (1.0, 1.0, 1.0), intensity: 40.0),
        Point(position: (3.0, 3.0, 3.0), color: (0.6, 0.7, 1.0), intensity: 15.0),
    ],
    objects: [
        Sphere(center: (0.0, -100.5, -1.0), radius: 100.0, material: Lambertian(albedo: (0.6, 0.6, 0.65))),
        Sphere(center: (-1.1, 0.0, -1.4), radius: 0.5, material: Lambertian(albedo: (0.2, 0.6, 0.3))),
        Sphere(center: (0.0, 0.0, -1.2), radius: 0.5, material: Metal(albedo: (0.85, 0.85, 0.9), fuzz: 0.02)),
        Sphere(center: (1.1, 0.0, -1.6), radius: 0.5, material: Dielectric(ior: 1.5)),
        Sphere(center: (0.15, -0.3, -0.55), radius: 0.2, material: Metal(albedo: (0.9, 0.7, 0.3), fuzz: 0.15)),
    ],
)
