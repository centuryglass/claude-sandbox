// Metal (not Lambertian) earth, so reflection-corrupting glitch modes
// (hit-chain-drift, axis-swap-reflect, angular-fold) actually engage with
// it - Lambertian never triggers their reflect branch at all.
(
    camera: (
        look_from: (0.0, 0.4, 3.4),
        look_at: (0.0, 0.0, 0.0),
        vfov: 40.0,
    ),
    ambient: (0.05, 0.05, 0.08),
    sky_bottom: (0.02, 0.02, 0.05),
    sky_top: (0.05, 0.05, 0.15),
    lights: [
        Point(position: (-4.0, 2.0, 3.0), color: (1.0, 1.0, 0.95), intensity: 30.0),
        Point(position: (3.0, 1.0, 2.0), color: (0.6, 0.7, 1.0), intensity: 12.0),
    ],
    objects: [
        Sphere(center: (0.0, 0.0, 0.0), radius: 1.1, material: Metal(albedo: Image("assets/textures/earth.jpg"), fuzz: 0.0)),
        Sphere(center: (1.7, -0.3, 0.9), radius: 0.4, material: Metal(albedo: Solid((0.9, 0.9, 0.95)), fuzz: 0.0)),
        Sphere(center: (-1.6, -0.5, 1.1), radius: 0.3, material: Dielectric(ior: 1.5)),
    ],
)
