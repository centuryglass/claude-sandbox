// Purpose-built to make the hit-chain-drift glitch visible: bold, high-
// contrast textures so the chaotic walk across geometry actually shows up
// as color variation, not just subtle shading noise.
// Render with: cargo run --release -- scenes/hit_chain_drift_demo.ron --glitch hit-chain-drift -s 256 -d 40
(
    camera: (
        look_from: (0.0, 1.0, 2.6),
        look_at: (0.0, 0.1, -1.0),
        vfov: 45.0,
    ),
    ambient: (0.05, 0.05, 0.05),
    sky_bottom: (1.0, 0.85, 0.1),
    sky_top: (0.85, 0.15, 0.55),
    lights: [
        Point(position: (-2.0, 3.5, 2.5), color: (1.0, 1.0, 1.0), intensity: 150.0),
    ],
    objects: [
        Sphere(center: (0.0, -100.5, -1.0), radius: 100.0, material: Lambertian(albedo: Checker(a: (0.9, 0.15, 0.5), b: (0.1, 0.8, 0.85), scale: 2.0))),
        Sphere(center: (0.9, -0.1, -0.5), radius: 0.45, material: Metal(albedo: Checker(a: (1.0, 0.9, 0.1), b: (0.1, 0.1, 0.9), scale: 6.0), fuzz: 0.0)),
        Sphere(center: (-0.9, -0.15, -0.6), radius: 0.4, material: Metal(albedo: Noise(color: (1.0, 0.5, 0.1), scale: 4.0, octaves: 4), fuzz: 0.0)),
        Sphere(center: (0.0, 0.15, -1.2), radius: 0.55, material: Metal(albedo: Stripes(a: (0.9, 0.9, 0.95), b: (0.05, 0.05, 0.1), scale: 8.0, axis: 1), fuzz: 0.0)),
        Sphere(center: (0.15, -0.35, -0.05), radius: 0.15, material: Metal(albedo: Solid((0.9, 0.75, 0.35)), fuzz: 0.05)),
    ],
)
